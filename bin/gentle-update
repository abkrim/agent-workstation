#!/usr/bin/env bash
# gentle-update: keep every agent tool current, as the dev user (no sudo, low priority):
#   gentle-shell  ~/src/gentle-shell from main (only when main moved; if installing fails, rolls back)
#                 and its Pi packages, the NaN provider included (gentle-shell update --extensions)
#   engram        go install <module declared by main>/cmd/engram@main      → ~/.local/bin
#   gentle-ai     go install <module declared by main>/cmd/gentle-ai@main   → ~/.local/bin
#   gga           ~/src/gga from main (git pull + ./install.sh)              → ~/.local/bin
#   Gentle AI     gentle-ai sync: refreshes what it configured in each agent, then the kit's
#                 guardrails are merged back (kit-guardrails)
#   CodeGraph     npm install -g @colbymchenry/codegraph@latest
#   Claude Code   claude update
#   Herdr         latest release (mise upgrade)
# The Go module path is read from main's go.mod on every run, so a new major version (v3 → v4)
# is followed instead of silently staying on the old one. Each part is independent: one failure
# does not stop the rest. gentle-update.timer runs it every 3 hours (modules/80-agents.sh).
# Exits 1 if anything failed.
set -uo pipefail

export PATH="$HOME/.local/share/mise/shims:$HOME/.local/bin:$PATH"
export GOBIN="$HOME/.local/bin"
mkdir -p "$GOBIN" "$HOME/src"

log() { echo "[$(date '+%F %T')] $*"; }
failed=()

install_gentle_shell_wrapper() {
  cat > "$HOME/.local/bin/gentle-shell" <<'EOF'
#!/usr/bin/env bash
# Managed by workstation-kit (bin/gentle-update). From a checkout, gentle-shell does not see Pi as a
# sibling package: GENTLE_SHELL_PI points it at the Pi that came with it.
export GENTLE_SHELL_PI="${GENTLE_SHELL_PI:-$HOME/src/gentle-shell/node_modules/.bin/pi}"
exec node "$HOME/src/gentle-shell/bin/gentle-shell.mjs" "$@"
EOF
  chmod 755 "$HOME/.local/bin/gentle-shell"
}

js_install() {  # lockfile decides the package manager
  if [ -f pnpm-lock.yaml ]; then pnpm install --frozen-lockfile; else npm ci; fi
}

update_gentle_shell() {
  local d="$HOME/src/gentle-shell" old new
  if [ ! -d "$d/.git" ]; then
    git clone --quiet --branch main https://github.com/Gentleman-Programming/gentle-shell.git "$d" || return 1
    (cd "$d" && js_install >/dev/null 2>&1) || return 1
    install_gentle_shell_wrapper
    log "gentle-shell installed ($(git -C "$d" rev-parse --short HEAD))"
    return 0
  fi
  install_gentle_shell_wrapper
  git -C "$d" fetch --quiet origin main || return 1
  old=$(git -C "$d" rev-parse HEAD); new=$(git -C "$d" rev-parse origin/main)
  if [ "$old" = "$new" ]; then log "gentle-shell up to date (${old:0:8})"; return 0; fi
  git -C "$d" reset --quiet --hard origin/main
  if (cd "$d" && js_install >/dev/null 2>&1); then
    log "gentle-shell ${old:0:8} → ${new:0:8}"
  else
    log "gentle-shell: installing ${new:0:8} failed; back to ${old:0:8}"
    git -C "$d" reset --quiet --hard "$old"
    (cd "$d" && js_install >/dev/null 2>&1)
    return 1
  fi
}

# module_of OWNER/REPO: the module path main's go.mod declares (e.g. .../gentle-ai/v4)
module_of() {
  curl -fsSL "https://raw.githubusercontent.com/$1/main/go.mod" | awk '/^module/ { print $2; exit }'
}

update_go_tool() {  # $1 binary name, $2 OWNER/REPO
  local mod
  mod=$(module_of "$2")
  [ -n "$mod" ] || { log "$1: could not read the module path of $2 main"; return 1; }
  set -- "$1" "$mod/cmd/$1@main"
  local bin="$GOBIN/$1" before after
  before=$(go version -m "$bin" 2>/dev/null | awk '$1=="mod"{print $3}')
  go install "$2" 2>&1 | tail -n 5 || return 1
  after=$(go version -m "$bin" 2>/dev/null | awk '$1=="mod"{print $3}')
  [ -n "$after" ] || return 1
  if [ "$before" = "$after" ]; then log "$1 up to date ($after)"; else log "$1 ${before:-(new)} → $after"; fi
}

update_gga() {
  local d="$HOME/src/gga" old new
  if [ ! -d "$d/.git" ]; then
    git clone --quiet --branch main https://github.com/Gentleman-Programming/gentleman-guardian-angel.git "$d" || return 1
    old=none
  else
    git -C "$d" fetch --quiet origin main || return 1
    old=$(git -C "$d" rev-parse HEAD)
  fi
  new=$(git -C "$d" rev-parse origin/main)
  if [ "$old" = "$new" ] && [ -x "$GOBIN/gga" ]; then log "gga up to date (${new:0:8})"; return 0; fi
  git -C "$d" reset --quiet --hard origin/main
  (cd "$d" && echo y | ./install.sh >/dev/null 2>&1) || return 1
  log "gga ${old:0:8} → ${new:0:8}"
}

update_pi_packages() {  # gentle-shell's Pi packages (NaN provider, engram bridge...). Pi itself comes
  [ -x "$HOME/.local/bin/gentle-shell" ] || return 0  # with gentle-shell's checkout, so only extensions here
  gentle-shell update --extensions >/dev/null 2>&1 || return 1
  log "gentle-shell packages updated"
}

update_gentle_ai_assets() {  # what gentle-ai set up in each agent; Pi is gentle-shell's own
  command -v gentle-ai >/dev/null && [ -f "$HOME/.gentle-ai/state.json" ] || return 0
  PATH="$HOME/src/gentle-shell/node_modules/.bin:$PATH" PI_CODING_AGENT_DIR="$HOME/.gentle-shell/agent" \
    gentle-ai sync </dev/null >/dev/null 2>&1 || return 1
  "${KIT_DIR:-/opt/workstation-kit}/bin/kit-guardrails" || return 1
  log "gentle-ai sync done"
}

update_codegraph() {
  command -v codegraph >/dev/null || return 0
  npm install -g --silent @colbymchenry/codegraph@latest >/dev/null 2>&1 || return 1
  log "codegraph $(codegraph --version 2>/dev/null | head -1)"
}

update_claude() {
  command -v claude >/dev/null || return 0
  local out
  out=$(claude update 2>&1) || { log "claude: $out" | tail -1; return 1; }
  log "claude: $(printf '%s\n' "$out" | grep -v '^\s*$' | tail -1)"
}

update_releases() {  # Herdr follows its latest release through mise
  mise upgrade --yes herdr >/dev/null 2>&1 || return 1
  log "$(herdr --version 2>/dev/null)"
}

update_gentle_shell || failed+=(gentle-shell)
update_pi_packages || failed+=(gentle-shell-packages)
update_go_tool engram    Gentleman-Programming/engram    || failed+=(engram)
update_go_tool gentle-ai Gentleman-Programming/gentle-ai || failed+=(gentle-ai)
update_gga || failed+=(gga)
update_gentle_ai_assets || failed+=(gentle-ai-sync)
update_codegraph || failed+=(codegraph)
update_claude || failed+=(claude)
update_releases || failed+=(herdr)

if [ ${#failed[@]} -gt 0 ]; then log "FAILED: ${failed[*]}"; exit 1; fi
log "OK"
