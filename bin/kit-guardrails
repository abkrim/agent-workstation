#!/usr/bin/env bash
# kit-guardrails: rules every agent keeps, merged into what is already there (never replaced).
#   - Claude Code refuses `git push --no-verify` and `gh repo delete`.
#   - Claude Code never stays in bypassPermissions: it moves to auto mode, where a safety classifier
#     reviews each action instead of asking you. Anthropic keeps bypassPermissions for isolated
#     containers or VMs without internet access (code.claude.com/docs/en/permission-modes), and
#     this machine is online with your GitHub and NaN credentials. To keep bypass anyway, create
#     ~/.config/agent-workstation/allow-bypass.
#   - GGA reviews with NaN through nan-gate's GGA port, and looks at every file of a pull request.
#     gentle-ai's gga component writes ~/.config/gga/config with PROVIDER="claude" and a short list
#     of file patterns, which would bill reviews to a Claude plan and skip docs and shell scripts.
#   - Pi's memory goes through gentle-engram's native mem_* tools only. Since engram 3.0 and
#     gentle-engram 0.2.0 the Engram MCP entry in Pi's mcp.json is a leftover that doubles the
#     tools and makes writes unreliable (gentle-engram warns about it at every start); the
#     pi-mcp-adapter package replaces Pi's built-in MCP support and Gentle AI 4.0 no longer wants
#     it. Both are removed when found.
# Run as the dev user by modules/88-gentle-ai.sh and 90-workflow.sh, and by gentle-update after
# each `gentle-ai sync`, because gentle-ai rewrites both files.
set -euo pipefail

gga_conf=$HOME/.config/gga/config
install -d -m 700 "$HOME/.config/gga"
[ -f "$gga_conf" ] || : > "$gga_conf"
set_conf() {  # set_conf KEY VALUE: replace the line or append it; other keys stay
  if grep -q "^$1=" "$gga_conf"; then
    sed -i "s|^$1=.*|$1=\"$2\"|" "$gga_conf"
  else
    printf '%s="%s"\n' "$1" "$2" >> "$gga_conf"
  fi
}
set_conf PROVIDER "lmstudio:glm5.3-flash"
set_conf LMSTUDIO_HOST "http://127.0.0.1:4881/v1"
set_conf FILE_PATTERNS "*"
set_conf RULES_FILE "AGENTS.md"
set_conf STRICT_MODE "true"
set_conf TIMEOUT "300"
chmod 600 "$gga_conf"
python3 - <<'EOF'
import json, os
home = os.path.expanduser("~")
p = f"{home}/.claude/settings.json"
s = json.load(open(p)) if os.path.exists(p) else {}
perms = s.setdefault("permissions", {})
deny = perms.setdefault("deny", [])
changed = False
for rule in ("Bash(gh repo delete *)", "Bash(git push --no-verify *)",
             "Bash(git push * --no-verify *)", "Bash(git push * --no-verify)"):
    if rule not in deny:
        deny.append(rule)
        changed = True
if perms.get("defaultMode") == "bypassPermissions" and not os.path.exists(f"{home}/.config/agent-workstation/allow-bypass"):
    perms["defaultMode"] = "auto"
    changed = True
if changed:
    os.makedirs(os.path.dirname(p), mode=0o700, exist_ok=True)
    with open(p + ".tmp", "w") as f:
        json.dump(s, f, indent=2)
        f.write("\n")
    os.chmod(p + ".tmp", 0o600)
    os.replace(p + ".tmp", p)
EOF

# Pi (gentle-shell): native memory tools only, no MCP adapter. Only when gentle-engram 0.2 or later
# is installed; an older gentle-engram still needs the MCP entry.
python3 - <<'EOF'
import json, os
agent = os.path.expanduser("~/.gentle-shell/agent")
pkg = f"{agent}/npm/node_modules/gentle-engram/package.json"
try:
    major, minor = (int(x) for x in json.load(open(pkg))["version"].split(".")[:2])
except Exception:
    raise SystemExit(0)
if (major, minor) < (0, 2):
    raise SystemExit(0)
def save(p, d):
    with open(p + ".tmp", "w") as f:
        json.dump(d, f, indent=2); f.write("\n")
    os.chmod(p + ".tmp", 0o600); os.replace(p + ".tmp", p)
m = f"{agent}/mcp.json"
if os.path.exists(m):
    d = json.load(open(m))
    if "engram" in d.get("mcpServers", {}):
        del d["mcpServers"]["engram"]
        save(m, d); print("✓ Pi: Engram MCP entry removed from mcp.json (native mem_* tools own memory)")
s = f"{agent}/settings.json"
if os.path.exists(s):
    d = json.load(open(s))
    pk = d.get("packages") or []
    keep = [x for x in pk if not str(x).startswith("npm:pi-mcp-adapter")]
    if keep != pk:
        d["packages"] = keep
        save(s, d); print("✓ Pi: pi-mcp-adapter dropped from packages (Pi has built-in MCP)")
EOF
