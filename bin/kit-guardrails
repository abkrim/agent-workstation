#!/usr/bin/env bash
# kit-guardrails: the rules every agent keeps, merged into what is already there (never replaced).
# Claude Code refuses `git push --no-verify` and `gh repo delete`. Run as the dev user by
# modules/90-workflow.sh, and by gentle-update after each `gentle-ai sync`, because gentle-ai's
# permissions component rewrites Claude Code's rules. OpenCode gets the same rules from
# config/opencode.json, and gentle-ai keeps them there.
set -euo pipefail
python3 - <<'EOF'
import json, os
p = os.path.expanduser("~/.claude/settings.json")
s = json.load(open(p)) if os.path.exists(p) else {}
deny = s.setdefault("permissions", {}).setdefault("deny", [])
added = [r for r in ("Bash(gh repo delete *)", "Bash(git push --no-verify *)",
                     "Bash(git push * --no-verify *)", "Bash(git push * --no-verify)") if r not in deny]
if added:
    deny.extend(added)
    os.makedirs(os.path.dirname(p), mode=0o700, exist_ok=True)
    with open(p + ".tmp", "w") as f:
        json.dump(s, f, indent=2)
        f.write("\n")
    os.chmod(p + ".tmp", 0o600)
    os.replace(p + ".tmp", p)
EOF
