#!/usr/bin/env bash
# wt: one worktree per task, with its own ports, an optional database and a Herdr workspace.
#
#   wt new <repo> <task> [feat|fix|chore]   creates ~/trees/<repo>--<task> on branch <type>/<task>
#   wt ls                                   lists open tasks
#   wt rm  <repo> <task> [--force]          closes the task: if the branch has unmerged work,
#                                           ci-local → PR → merge (only when green); then stops the
#                                           database, removes worktree and branch, frees the slot.
#                                           --force: throw away everything unmerged, no merge
#
# Ports per slot N (1-99), always on 127.0.0.1: base = 20000 + N*10
#   PORT=base  WT_PG_PORT=base+1  WT_REDIS_PORT=base+2  WT_EXTRA_PORT=base+3
#
# What a repo can declare (all optional):
#   .wt/compose.yaml or compose.yaml   started with docker compose (uses ${WT_PG_PORT} etc.)
#   .wt/config                         WT_PG_IMAGE=postgres:17 → a plain Postgres if there is no compose
#   .wt/setup                          executable: dependencies, migrations, seed
#   .wt/ci                             executable: the repo's own checks for ci-local
set -euo pipefail

WORK="${WT_WORK:-$HOME/work}"
TREES="${WT_TREES:-$HOME/trees}"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/wt"
mkdir -p "$STATE/slots" "$TREES"

die() { echo "wt: $*" >&2; exit 1; }
valid() { [[ "$1" =~ ^[a-z0-9][a-z0-9._-]*$ ]] || die "invalid name: '$1' (lowercase, digits, . _ -)"; }
herdr_up() { command -v herdr >/dev/null && herdr status server >/dev/null 2>&1; }

compose_file() {  # prints the worktree's compose file, if any
  local d="$1" f
  for f in .wt/compose.yaml compose.yaml compose.yml docker-compose.yml docker-compose.yaml; do
    [ -f "$d/$f" ] && { echo "$d/$f"; return 0; }
  done
  return 0
}

alloc_slot() {  # mkdir is atomic: two simultaneous wt new never share a slot
  local n
  for n in $(seq 1 99); do
    if mkdir "$STATE/slots/$n" 2>/dev/null; then echo "$n"; return; fi
  done
  die "no free slots left (99)"
}

herdr_close_ws() {  # closes the Herdr workspaces whose worktree is $1
  herdr_up || return 0
  herdr workspace list 2>/dev/null | python3 -c '
import json, sys
path = sys.argv[1]
for w in json.load(sys.stdin).get("result", {}).get("workspaces", []):
    if (w.get("worktree") or {}).get("checkout_path") == path:
        print(w["workspace_id"])
' "$1" | while read -r id; do herdr workspace close "$id" >/dev/null 2>&1 || true; done
}

slot_of() { grep -lx "$1" "$STATE"/slots/*/name 2>/dev/null | head -n1 | xargs -r dirname | xargs -r basename; }

cmd_new() {
  local repo="${1:-}" task="${2:-}" kind="${3:-feat}"
  [ -n "$repo" ] && [ -n "$task" ] || die "usage: wt new <repo> <task> [feat|fix|chore]"
  valid "$repo"; valid "$task"
  [[ "$kind" =~ ^(feat|fix|chore)$ ]] || die "invalid type: $kind"
  local src="$WORK/$repo" name="$repo--$task" dir="$TREES/$repo--$task" branch="$kind/$task"
  git -C "$src" rev-parse --git-dir >/dev/null 2>&1 || die "$src is not a git repo (add it with: repo-add <owner>/$repo)"
  [ -e "$dir" ] && die "$dir already exists"
  [ -z "$(slot_of "$name")" ] || die "$name already has a slot"

  local base=main
  if git -C "$src" remote get-url origin >/dev/null 2>&1; then
    git -C "$src" fetch --quiet origin
    base=origin/$(git -C "$src" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's|^origin/||' || echo main)
  fi

  local n; n=$(alloc_slot)
  echo "$name" > "$STATE/slots/$n/name"
  trap 'rm -rf "$STATE/slots/$n"; echo "wt: failed at line $LINENO; slot $n freed. Check $dir and use \"wt rm $repo $task --force\" if it was left half-done." >&2' ERR

  if herdr_up; then
    herdr worktree create --cwd "$src" --branch "$branch" --base "$base" --path "$dir" --label "$name" --no-focus >/dev/null
  else
    git -C "$src" worktree add --quiet -b "$branch" "$dir" "$base"
  fi
  if command -v claude-trust >/dev/null; then claude-trust "$dir"; fi  # Claude Code opens it without asking

  local p=$((20000 + n * 10))
  cat > "$dir/.env.wt" <<EOF
# Generated by wt (slot $n). Never committed.
WT_NAME=$name
WT_SLOT=$n
COMPOSE_PROJECT_NAME=$name
HOST=127.0.0.1
PORT=$p
WT_PG_PORT=$((p + 1))
WT_REDIS_PORT=$((p + 2))
WT_EXTRA_PORT=$((p + 3))
EOF
  local exclude; exclude="$(git -C "$src" rev-parse --path-format=absolute --git-common-dir)/info/exclude"
  grep -qxF ".env.wt" "$exclude" 2>/dev/null || echo ".env.wt" >> "$exclude"

  local cf; cf=$(compose_file "$dir")
  if [ -n "$cf" ]; then
    docker compose -f "$cf" --env-file "$dir/.env.wt" -p "$name" up -d
  elif [ -f "$dir/.wt/config" ] && grep -q '^WT_PG_IMAGE=' "$dir/.wt/config"; then
    local img; img=$(grep '^WT_PG_IMAGE=' "$dir/.wt/config" | cut -d= -f2-)
    docker run -d --name "$name-pg" --label "wt=$name" \
      -e POSTGRES_USER=app -e POSTGRES_PASSWORD=app -e POSTGRES_DB=app \
      -p "127.0.0.1:$((p + 1)):5432" -v "$name-pg:/var/lib/postgresql/data" "$img" >/dev/null
    echo "DATABASE_URL=postgres://app:app@127.0.0.1:$((p + 1))/app" >> "$dir/.env.wt"
  fi

  if [ -x "$dir/.wt/setup" ]; then
    (cd "$dir" && set -a && . ./.env.wt && set +a && ./.wt/setup)
  fi
  trap - ERR

  echo "✓ $name  slot $n  branch $branch  from $base"
  echo "  $dir"
  echo "  PORT=$p  PG=$((p + 1))  (127.0.0.1)"
  herdr_up || echo "  (Herdr is not running: open 'herdr' and use 'herdr worktree open' for its workspace)"
}

cmd_ls() {
  local s n name dir br db
  printf '%-4s %-40s %-28s %-6s %s\n' SLOT TASK BRANCH PORT DB
  for s in "$STATE"/slots/*/name; do
    [ -f "$s" ] || continue
    n=$(basename "$(dirname "$s")"); name=$(cat "$s"); dir="$TREES/$name"
    br=$(git -C "$dir" branch --show-current 2>/dev/null || echo "?")
    db=$(docker ps -q --filter "label=com.docker.compose.project=$name" 2>/dev/null | wc -l)
    db=$((db + $(docker ps -q --filter "label=wt=$name" 2>/dev/null | wc -l)))
    printf '%-4s %-40s %-28s %-6s %s\n' "$n" "$name" "$br" "$((20000 + n * 10))" "$([ "$db" -gt 0 ] && echo "$db containers" || echo -)"
  done
}

cmd_rm() {
  local repo="${1:-}" task="${2:-}" force="${3:-}"
  [ -n "$repo" ] && [ -n "$task" ] || die "usage: wt rm <repo> <task> [--force]"
  valid "$repo"; valid "$task"
  local src="$WORK/$repo" name="$repo--$task" dir="$TREES/$repo--$task"
  local n; n=$(slot_of "$name")

  local branch="" merged=0  # 0 unmerged (--force) · 1 merged · 2 no changes
  [ -d "$dir" ] && branch=$(git -C "$dir" branch --show-current 2>/dev/null || true)

  # Without --force the task is closed for good: whatever the branch has unmerged goes through
  # ci-local, a PR and a merge (only if ci-local is green). If anything fails, nothing is removed.
  if [ -d "$dir" ] && [ -n "$branch" ] && [ "$force" != "--force" ]; then
    [ -z "$(git -C "$dir" status --porcelain)" ] ||
      die "uncommitted changes in $dir: ask the agent to commit them (or use --force to throw them away)"
    git -C "$dir" fetch -q origin main
    local pr_state
    pr_state=$(cd "$dir" && gh pr view "$branch" --json state -q .state 2>/dev/null || true)
    if [ -z "$(git -C "$dir" rev-list origin/main..HEAD)" ]; then
      merged=2
    elif [ "$pr_state" = MERGED ] || git -C "$dir" merge-base --is-ancestor HEAD origin/main; then
      merged=1
    else
      echo "▸ $branch has unmerged work: ci-local, PR and merge"
      (cd "$dir" && ci-local) ||
        die "ci-local is not green: nothing pushed, merged or removed. Fix it in the task and run wt rm again"
      local out
      out=$(git -C "$dir" push -q -u origin "$branch" 2>&1) || { printf '%s\n' "$out" >&2; die "pushing $branch failed: nothing removed"; }
      if [ "$pr_state" != OPEN ]; then
        (cd "$dir" && gh pr create --base main --head "$branch" --fill >/dev/null)
      fi
      (cd "$dir" && gh pr merge "$branch" --merge) || die "merging the PR failed: nothing removed"
      echo "✓ $branch merged into main"
      merged=1
    fi
  fi

  # Without --force, git refuses to remove a worktree with uncommitted changes: protects the work
  if [ -d "$dir" ]; then
    if [ "$force" = "--force" ]; then git -C "$src" worktree remove --force "$dir"
    else git -C "$src" worktree remove "$dir" || die "uncommitted changes in $dir (use --force to throw them away)"
    fi
  fi

  docker compose -p "$name" down -v --remove-orphans >/dev/null 2>&1 || true
  docker rm -f "$name-pg" >/dev/null 2>&1 || true
  docker volume rm "$name-pg" >/dev/null 2>&1 || true

  if [ -n "$branch" ]; then
    if [ "$merged" = 2 ]; then
      git -C "$src" branch -D "$branch" >/dev/null 2>&1 || true
      echo "  branch $branch removed (no changes)"
    elif [ "$merged" = 1 ]; then
      # Merged on GitHub: removed here and on the remote, and the main checkout is brought up to date
      git -C "$src" branch -D "$branch" >/dev/null 2>&1 || true
      git -C "$src" push -q origin --delete "$branch" >/dev/null 2>&1 || true
      git -C "$src" pull -q --ff-only origin main >/dev/null 2>&1 || true
      echo "  branch $branch removed (merged)"
    else
      git -C "$src" branch -d "$branch" >/dev/null 2>&1 \
        && echo "  branch $branch removed (no changes)" \
        || echo "  branch $branch kept (--force: not merged; delete it yourself if you no longer want it)"
    fi
  fi
  git -C "$src" worktree prune
  herdr_close_ws "$dir"
  [ -n "$n" ] && rm -rf "$STATE/slots/$n"
  echo "✓ $name closed"
}

case "${1:-}" in
  new) shift; cmd_new "$@" ;;
  ls)  shift; cmd_ls "$@" ;;
  rm)  shift; cmd_rm "$@" ;;
  *)   sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
